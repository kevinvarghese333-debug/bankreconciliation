# Copy to .env and adjust.

# Port on this machine (the app is only reachable from localhost; see README for VPS).
PORT=8077

# Optional: create the login automatically on first start.
# Leave empty to create it in the browser on first visit instead.
APP_USER=
APP_PASSWORD=

# Set to 1 once the app is behind HTTPS on the VPS (makes the login cookie HTTPS-only).
HTTPS_ONLY=0

# Keep a copy of every uploaded file under data/uploads/<run id>/ for audit (1) or discard after processing (0).
KEEP_UPLOADS=1
